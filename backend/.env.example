# AI Avatar Backend - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Environment Configuration
# ============================================
ENVIRONMENT=local
LOG_LEVEL=INFO

# ============================================
# LM Studio Configuration (Local Development)
# ============================================
LM_STUDIO_ENDPOINT=http://localhost:1234
LM_STUDIO_MODEL=google/gemma-3-1b
LM_STUDIO_TIMEOUT=60

# ============================================
# AWS Bedrock Configuration (Lambda)
# ============================================
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_REGION=us-east-1
AWS_REGION=ap-northeast-1

# ============================================
# API Configuration
# ============================================
API_TITLE=AI Avatar API
API_VERSION=1.0.0
CORS_ORIGINS=["*"]

# ============================================
# Notes
# ============================================
# - For local development, set ENVIRONMENT=local
# - Make sure LM Studio is running before starting the server
# - In Lambda, AWS credentials are provided by IAM role
# - CORS_ORIGINS should be restricted in production
